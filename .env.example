# ── public ──
DOMAIN=teman.my
PUBLIC_URL=https://teman.my

# ── database ──
POSTGRES_USER=teman
POSTGRES_PASSWORD=change-me
POSTGRES_DB=teman
DATABASE_URL=postgres://teman:change-me@localhost:5432/teman   # local dev only

# ── auth ──
AUTH_SECRET=            # openssl rand -base64 32

# ── storage: ID documents and selfies. Deliberately not on the app disk. ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=teman-documents
R2_BUCKET_BACKUP=teman-backups
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# ── SMS. Rate limits live in code, not here — see lib/otp.ts ──
SMS_PROVIDER_KEY=

# ── web push ──
VAPID_PUBLIC_KEY=       # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=

# ── ops ──
SENTRY_DSN=
BACKUP_PASSPHRASE=      # NOT the database password. Store this somewhere else.

# ── demo only. Must be absent in production; the seed script refuses to run without it. ──
# DEMO_MODE=true
# DEMO_OTP=000000
