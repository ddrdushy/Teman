{
  "name": "teman",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "esbuild src/worker.ts --bundle --platform=node --target=node22 --external:pg-native --outfile=dist/worker.js",
    "start": "next start",
    "check:contrast": "node scripts/check-contrast.mjs",
    "db:generate": "drizzle-kit generate && node scripts/unquote-geography.mjs",
    "db:push": "drizzle-kit push",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:report": "node scripts/test-report.mjs",
    "test:report:quick": "node scripts/test-report.mjs --quick",
    "test:report:open": "playwright show-report test-reports/playwright-html",
    "seed:demo": "node scripts/seed/areas.mjs && node scripts/seed/categories.mjs && node scripts/seed/admins.mjs && node scripts/seed/demo.mjs",
    "build:migrate": "esbuild src/migrate.ts --bundle --platform=node --target=node22 --external:pg-native --outfile=dist/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "drizzle-orm": "^0.38.4",
    "next": "^15.1.6",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^3.26.3",
    "pg-boss": "^10.1.6",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.24.2",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0"
}
